# --- Telegram -------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456:replace-me
# Comma-separated Telegram user IDs allowed to use the bot. EMPTY = NOBODY.
# Send /start to the bot once; the refusal message tells you your ID.
ALLOWED_USER_IDS=
# Roles (owner > admin > user). If OWNER_IDS is empty, everyone in
# ALLOWED_USER_IDS is an owner (0.1.x behaviour); otherwise they are users.
OWNER_IDS=
ADMIN_IDS=
# Backends each role may use (comma list, empty or * = all configured).
# ROLE_BACKENDS_USER=echo,openai
# Who may press Approve/Deny (defaults: owner and admin yes, user no).
# ROLE_APPROVE_USER=false
# Group/supergroup chat IDs the bot may talk in (EMPTY = no groups). In a group
# it only answers @mentions, replies to its own messages, and commands; the
# sender still needs a role. Run /start in the group to see its ID.
ALLOWED_GROUP_IDS=
# polling (default) or webhook
BOT_MODE=polling
# Webhook mode only: public HTTPS URL that routes to HTTP_PORT, plus a secret
# (1-256 chars of A-Z a-z 0-9 _ -) that Telegram echoes back in a header.
WEBHOOK_URL=
WEBHOOK_SECRET=
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
# Point at a local Bot API server or a fake for testing.
# TELEGRAM_API_BASE=https://api.telegram.org

# --- Bot behaviour ---------------------------------------------------------
DB_PATH=data/claw-telegram.db
# echo | openclaw | hermes | openai | claude
DEFAULT_BACKEND=echo
HISTORY_LIMIT=40
RATE_LIMIT_PER_MINUTE=20
APPROVAL_TIMEOUT_S=300
STREAM_EDIT_INTERVAL_S=1.2
# SYSTEM_PROMPT=You are a helpful personal assistant talking to the user over Telegram.

# --- OpenClaw gateway (enable gateway.http.endpoints.chatCompletions) ------
OPENCLAW_URL=
OPENCLAW_TOKEN=
OPENCLAW_AGENT=openclaw/default
# Connect to the gateway WebSocket as a loopback backend client to relay
# exec approvals to Telegram (requires operator.approvals).
OPENCLAW_APPROVALS_WS=false

# --- Hermes Agent API server (API_SERVER_ENABLED=true, default port 8642) --
HERMES_URL=
HERMES_API_KEY=
HERMES_MODEL=hermes-agent

# --- Any OpenAI-compatible endpoint (Hermes models on Ollama/vLLM/OpenRouter)
# e.g. http://localhost:11434/v1 with OPENAI_MODEL=hermes3
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Claude fallback (pip install 'claw-telegram[claude]') -----------------
ENABLE_CLAUDE=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Voice notes: OpenAI-compatible /v1/audio/transcriptions ---------------
TRANSCRIBE_URL=
TRANSCRIBE_API_KEY=
TRANSCRIBE_MODEL=whisper-1
